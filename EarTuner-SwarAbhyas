<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Swar Abhyas - Ear Trainer</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between p-4 font-sans">

    <!-- Header -->
    <header class="text-center my-4">
        <h1 class="text-3xl font-bold tracking-wide text-amber-400">Ear Trainer -Swar Abhyas</h1>
        <p class="text-sm text-slate-400 mt-1">Music Ear Trainer</p>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto w-full space-y-6">

        <!-- Settings Card -->
        <div class="bg-slate-800 rounded-xl p-5 border border-slate-700 space-y-4 shadow-lg">
            
            <!-- Base Pitch -->
            <div>
                <label for="scaleSelect" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Base Pitch (Sa)</label>
                <select id="scaleSelect" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500">
                    <option value="196.00">G (196.00 Hz)</option>
                    <option value="207.65">G# (207.65 Hz)</option>
                    <option value="220.00">A (220.00 Hz)</option>
                    <option value="233.08">A# (233.08 Hz)</option>
                    <option value="246.94">B (246.94 Hz)</option>
                    <option value="261.63" selected>C (261.63 Hz)</option>
                    <option value="277.18">C# (277.18 Hz)</option>
                    <option value="293.66">D (293.66 Hz)</option>
                    <option value="311.13">D# (311.13 Hz)</option>
                    <option value="329.63">E (329.63 Hz)</option>
                    <option value="349.23">F (349.23 Hz)</option>
                    <option value="369.99">F# (369.99 Hz)</option>
                </select>
            </div>

            <!-- Practice Mode Toggle -->
            <div>
                <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Practice Mode</label>
                <div class="grid grid-cols-2 gap-2 bg-slate-900 p-1.5 rounded-lg border border-slate-700">
                    <label class="flex items-center justify-center p-2 rounded-md cursor-pointer text-sm font-medium transition-colors" id="modeShudhLabel">
                        <input type="radio" name="practiceMode" value="shudh" checked class="hidden" id="modeShudh">
                        <span>Shudh Only</span>
                    </label>
                    <label class="flex items-center justify-center p-2 rounded-md cursor-pointer text-sm font-medium transition-colors" id="modeMixedLabel">
                        <input type="radio" name="practiceMode" value="mixed" class="hidden" id="modeMixed">
                        <span>Mixed Notes</span>
                    </label>
                </div>
            </div>

            <!-- Sound Instrument -->
            <div>
                <label for="soundSelect" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Sound Instrument</label>
                <select id="soundSelect" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500">
                    <option value="harmonium">Harmonium (Reeds)</option>
                    <option value="bansuri">Bansuri (Flute)</option>
                    <option value="piano">Piano (Keyboard)</option>
                </select>
            </div>

        </div>

        <!-- Action Buttons -->
        <div class="flex gap-3">
            <button id="playSaBtn" class="flex-1 bg-slate-700 hover:bg-slate-600 active:bg-slate-800 text-slate-200 font-semibold py-3 px-4 rounded-xl border border-slate-600 transition shadow">
                Play Base Sa
            </button>
            <button id="playRandomBtn" class="flex-1 bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-slate-950 font-bold py-3 px-4 rounded-xl transition shadow">
                Play Random Note
            </button>
            <button id="repeatBtn" disabled class="bg-slate-800 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed text-slate-200 p-3 rounded-xl border border-slate-700 transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            </button>
        </div>

        <!-- Status & Score Banner -->
        <div class="bg-slate-800/60 rounded-xl p-4 border border-slate-700/60 text-center">
            <div id="statusMessage" class="text-slate-300 text-sm font-medium min-h-[20px]">
                Select your settings and press "Play Random Note"
            </div>
            <div class="flex justify-center items-center gap-6 mt-3 text-xs text-slate-400 font-mono border-t border-slate-700/50 pt-2">
                <div>Score: <span id="scoreVal" class="text-amber-400 font-bold text-sm">0/0</span></div>
                <div>Streak: <span id="streakVal" class="text-amber-400 font-bold text-sm">0</span></div>
            </div>
        </div>

        <!-- Interactive Swara Grid -->
        <div id="swaraGrid" class="grid grid-cols-3 sm:grid-cols-4 gap-3"></div>

    </main>

    <footer class="text-center text-xs text-slate-500 my-4">
        Swar Abhyas • Mobile-ready Ear Training Tool
    </footer>

    <script>
        const SWARAS = [
            { id: "S",  name: "Sa",  type: "Shudh", semitones: 0,  isShudh: true },
            { id: "r",  name: "re",  type: "Komal", semitones: 1,  isShudh: false },
            { id: "R",  name: "Re",  type: "Shudh", semitones: 2,  isShudh: true },
            { id: "g",  name: "ga",  type: "Komal", semitones: 3,  isShudh: false },
            { id: "G",  name: "Ga",  type: "Shudh", semitones: 4,  isShudh: true },
            { id: "m",  name: "ma",  type: "Shudh", semitones: 5,  isShudh: true },
            { id: "M",  name: "Ma",  type: "Teevr", semitones: 6,  isShudh: false },
            { id: "P",  name: "Pa",  type: "Shudh", semitones: 7,  isShudh: true },
            { id: "d",  name: "dha", type: "Komal", semitones: 8,  isShudh: false },
            { id: "D",  name: "Dha", type: "Shudh", semitones: 9,  isShudh: true },
            { id: "n",  name: "ni",  type: "Komal", semitones: 10, isShudh: false },
            { id: "N",  name: "Ni",  type: "Shudh", semitones: 11, isShudh: true },
            { id: "S2", name: "Sa'", type: "Shudh", semitones: 12, isShudh: true }
        ];

        let audioCtx = null;
        let activeNodes = []; // Tracks currently active sound sources for monophonic playback
        let activeTarget = null;
        let scoreCount = 0;
        let totalAttempts = 0;
        let streakCount = 0;
        let currentMode = 'shudh';

        const scaleSelect = document.getElementById('scaleSelect');
        const soundSelect = document.getElementById('soundSelect');
        const modeShudhInput = document.getElementById('modeShudh');
        const modeMixedInput = document.getElementById('modeMixed');
        const modeShudhLabel = document.getElementById('modeShudhLabel');
        const modeMixedLabel = document.getElementById('modeMixedLabel');
        const playSaBtn = document.getElementById('playSaBtn');
        const playRandomBtn = document.getElementById('playRandomBtn');
        const repeatBtn = document.getElementById('repeatBtn');
        const statusMessage = document.getElementById('statusMessage');
        const scoreVal = document.getElementById('scoreVal');
        const streakVal = document.getElementById('streakVal');
        const swaraGrid = document.getElementById('swaraGrid');

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        // Instantly stops any previously playing sound nodes
        function stopActiveAudio() {
            activeNodes.forEach(node => {
                try {
                    if (node.stop) node.stop();
                    if (node.disconnect) node.disconnect();
                } catch (e) {}
            });
            activeNodes = [];
        }

        function playTone(freq, instrument = 'harmonium', duration = 3.0) {
            stopActiveAudio(); // Stop any overlapping sound before playing new note
            const ctx = getAudioContext();
            const now = ctx.currentTime;

            const masterGain = ctx.createGain();
            masterGain.connect(ctx.destination);

            if (instrument === 'harmonium') {
                const osc1 = ctx.createOscillator();
                const osc2 = ctx.createOscillator();
                
                osc1.type = 'sawtooth';
                osc2.type = 'square';

                osc1.frequency.setValueAtTime(freq, now);
                osc2.frequency.setValueAtTime(freq * 1.002, now);

                const filter = ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(1400, now);

                osc1.connect(filter);
                osc2.connect(filter);
                filter.connect(masterGain);

                masterGain.gain.setValueAtTime(0, now);
                masterGain.gain.linearRampToValueAtTime(0.3, now + 0.1);
                masterGain.gain.exponentialRampToValueAtTime(0.001, now + duration);

                osc1.start(now);
                osc2.start(now);
                osc1.stop(now + duration);
                osc2.stop(now + duration);

                activeNodes.push(osc1, osc2, masterGain);

            } else if (instrument === 'bansuri') {
                const osc = ctx.createOscillator();
                const lfo = ctx.createOscillator();
                const lfoGain = ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, now);

                lfo.frequency.setValueAtTime(4.5, now);
                lfoGain.gain.setValueAtTime(freq * 0.008, now);

                lfo.connect(osc.frequency);
                osc.connect(masterGain);

                masterGain.gain.setValueAtTime(0, now);
                masterGain.gain.linearRampToValueAtTime(0.35, now + 0.25);
                masterGain.gain.exponentialRampToValueAtTime(0.001, now + duration);

                lfo.start(now);
                osc.start(now);
                lfo.stop(now + duration);
                osc.stop(now + duration);

                activeNodes.push(osc, lfo, masterGain);

            } else if (instrument === 'piano') {
                const osc = ctx.createOscillator();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, now);

                osc.connect(masterGain);

                masterGain.gain.setValueAtTime(0.6, now);
                masterGain.gain.exponentialRampToValueAtTime(0.001, now + duration);

                osc.start(now);
                osc.stop(now + duration);

                activeNodes.push(osc, masterGain);
            }
        }

        function calculateFreq(semitones) {
            const baseFreq = parseFloat(scaleSelect.value);
            return baseFreq * Math.pow(2, semitones / 12);
        }

        function renderGrid() {
            swaraGrid.innerHTML = '';
            const activeList = SWARAS.filter(s => currentMode === 'mixed' || s.isShudh);

            activeList.forEach(swar => {
                const btn = document.createElement('button');
                btn.dataset.id = swar.id;
                btn.className = `swara-btn flex flex-col items-center justify-center p-4 rounded-xl border border-slate-700 bg-slate-800 hover:bg-slate-750 active:scale-95 transition shadow disabled:opacity-50 disabled:cursor-not-allowed`;
                
                let badgeColor = 'text-amber-400';
                if (swar.type === 'Komal') badgeColor = 'text-cyan-400';
                if (swar.type === 'Teevr') badgeColor = 'text-rose-400';

                btn.innerHTML = `
                    <span class="text-xl font-bold text-slate-100">${swar.name}</span>
                    <span class="text-[10px] ${badgeColor} uppercase tracking-wider font-semibold mt-1">${swar.type}</span>
                `;

                btn.addEventListener('click', () => handleGuess(swar));
                swaraGrid.appendChild(btn);
            });

            updateModeToggleUI();
        }

        function updateModeToggleUI() {
            if (currentMode === 'shudh') {
                modeShudhLabel.className = "flex items-center justify-center p-2 rounded-md cursor-pointer text-sm font-medium transition-colors bg-amber-500 text-slate-950 font-bold shadow";
                modeMixedLabel.className = "flex items-center justify-center p-2 rounded-md cursor-pointer text-sm font-medium transition-colors text-slate-400 hover:text-slate-200";
            } else {
                modeMixedLabel.className = "flex items-center justify-center p-2 rounded-md cursor-pointer text-sm font-medium transition-colors bg-amber-500 text-slate-950 font-bold shadow";
                modeShudhLabel.className = "flex items-center justify-center p-2 rounded-md cursor-pointer text-sm font-medium transition-colors text-slate-400 hover:text-slate-200";
            }
        }

        function playBaseSa() {
            playTone(calculateFreq(0), soundSelect.value);
            statusMessage.innerText = "Played Base Sa";
            statusMessage.className = "text-slate-300 text-sm font-medium min-h-[20px]";
        }

        function playRandomSwara() {
            const availableSwaras = SWARAS.filter(s => currentMode === 'mixed' || s.isShudh);
            const randomIndex = Math.floor(Math.random() * availableSwaras.length);
            activeTarget = availableSwaras[randomIndex];

            playTone(calculateFreq(activeTarget.semitones), soundSelect.value);
            
            repeatBtn.disabled = false;
            statusMessage.innerText = "Listen carefully! Identify the Swar...";
            statusMessage.className = "text-amber-400 text-sm font-medium min-h-[20px] animate-pulse";

            document.querySelectorAll('.swara-btn').forEach(btn => {
                btn.className = `swara-btn flex flex-col items-center justify-center p-4 rounded-xl border border-slate-700 bg-slate-800 hover:bg-slate-750 active:scale-95 transition shadow`;
                btn.disabled = false;
            });
        }

        function repeatSwara() {
            if (activeTarget) {
                playTone(calculateFreq(activeTarget.semitones), soundSelect.value);
            }
        }

        function handleGuess(selectedSwar) {
            if (!activeTarget) {
                playTone(calculateFreq(selectedSwar.semitones), soundSelect.value);
                return;
            }

            playTone(calculateFreq(selectedSwar.semitones), soundSelect.value);

            totalAttempts++;
            const isCorrect = (selectedSwar.id === activeTarget.id);
            const clickedBtn = document.querySelector(`[data-id="${selectedSwar.id}"]`);

            if (isCorrect) {
                scoreCount++;
                streakCount++;
                statusMessage.innerText = `Correct! It was ${activeTarget.name} (${activeTarget.type})`;
                statusMessage.className = "text-emerald-400 text-sm font-bold min-h-[20px]";
                if (clickedBtn) {
                    clickedBtn.className = "swara-btn flex flex-col items-center justify-center p-4 rounded-xl border border-emerald-500 bg-emerald-950/80 text-white transition shadow";
                }
                activeTarget = null;
            } else {
                streakCount = 0;
                statusMessage.innerText = `Incorrect. You played ${selectedSwar.name}. Try again or press Play Random!`;
                statusMessage.className = "text-rose-400 text-sm font-bold min-h-[20px]";
                if (clickedBtn) {
                    clickedBtn.className = "swara-btn flex flex-col items-center justify-center p-4 rounded-xl border border-rose-500 bg-rose-950/80 text-white transition shadow";
                }
            }

            scoreVal.innerText = `${scoreCount}/${totalAttempts}`;
            streakVal.innerText = streakCount;
        }

        playSaBtn.addEventListener('click', playBaseSa);
        playRandomBtn.addEventListener('click', playRandomSwara);
        repeatBtn.addEventListener('click', repeatSwara);

        modeShudhInput.addEventListener('change', () => {
            currentMode = 'shudh';
            activeTarget = null;
            repeatBtn.disabled = true;
            statusMessage.innerText = "Switched to Shudh Notes";
            statusMessage.className = "text-slate-300 text-sm font-medium min-h-[20px]";
            renderGrid();
        });

        modeMixedInput.addEventListener('change', () => {
            currentMode = 'mixed';
            activeTarget = null;
            repeatBtn.disabled = true;
            statusMessage.innerText = "Switched to Mixed Notes";
            statusMessage.className = "text-slate-300 text-sm font-medium min-h-[20px]";
            renderGrid();
        });

        renderGrid();
    </script>
</body>
</html>
